# Copy to .env for local dev: `deno task dev --env-file`
# In production, set these in the Deno Deploy dashboard instead — never commit real values.
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_string
OWNER_TELEGRAM_ID=replace_with_your_numeric_telegram_id
ADMIN_API_KEY=replace_with_another_long_random_string
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=verify-full

# Optional
ADMIN_NOTIFY_CHAT_ID=
AUTO_APPROVE_JOIN_REQUESTS=false
